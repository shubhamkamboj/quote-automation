# Instagram / Meta
IG_USER_ID=
IG_ACCESS_TOKEN=
META_API_VERSION=v25.0
HASHTAGS=#LifeQuotes #HindiQuotes #Zindagi #PositiveThoughts #DailyQuotes

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional priority addon (plain text file: priority.txt)
# No API or secret is needed. If the file is empty, Gemini is used normally.

# Failure email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# Publishing controls (GitHub Repository Variables)
# ENABLE_IMAGE_POSTS=true/false
ENABLE_IMAGE_POSTS=true
IMAGE_POST_COUNT=4
REEL_POST_COUNT=4

# Image source
# false = use templates/template-*.jpg
# true  = generate the visual background with Gemini
USE_GEMINI_IMAGE=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
